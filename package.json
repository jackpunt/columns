{
  "name": "columns",
  "version": "0.2.1",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "assets": "npx gulp asset-tags",
    "circles": "npx madge --circular --extensions ts --ts-config ./tsconfig.json ./src",
    "build": "ng build",
    "builds": "ng build --configuration standalone",
    "buildsd": "ng build --configuration standalone --optimization=false --source-map=true",
    "buildin": "gulp insert-inline-attrs && npx inline-source-cli --root ./dist/columns/ ./dist/columns/index.html ./dist-standalone/cursus.html",
    "buildx": "npm run builds && npx gulp set-build-date && npm run buildin",
    "buildxd": "npm run buildsd && npx gulp set-build-date && npm run buildin",
    "pub": "cp ./dist-standalone/cursus.html ~/Google\\ Drive/",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "newcom": "npm i ../../ts/common-lib/thegraid-common-lib-*.tgz ; rm -rf .angular/cache ; date",
    "newhex": "npm i ../../ts/hexlib/thegraid-hexlib-*.tgz ; rm -rf .angular/cache ; date",
    "newejs": "npm i ../../ts/createjs-module/thegraid-easeljs-module-*.tgz ; rm -rf .angular/cache ; date",
    "newlib": "npm i ../../ts/createjs-lib/thegraid-easeljs-lib-*.tgz ; rm -rf .angular/cache; date"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.2.26",
    "@angular/common": "^21.2.26",
    "@angular/compiler": "^21.2.26",
    "@angular/core": "^21.2.26",
    "@angular/forms": "^21.2.26",
    "@angular/platform-browser": "^21.2.26",
    "@angular/platform-browser-dynamic": "^21.2.26",
    "@angular/router": "^21.2.26",
    "@thegraid/common-lib": "^1.3.50",
    "@thegraid/easeljs-lib": "^1.5.8",
    "@thegraid/easeljs-module": "^1.4.0",
    "@thegraid/hexlib": "^1.5.5",
    "file-loader": "^6.2.0",
    "jszip": "^3.10.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "madge": {
    "detectiveOptions": {
      "ts": {
        "skipTypeImports": true
      },
      "tsx": {
        "skipTypeImports": true
      }
    }
  },
  "devDependencies": {
    "@angular/build": "^21.2.30",
    "@angular/cli": "^21.2.30",
    "@angular/compiler-cli": "^21.2.26",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^18.15.11",
    "@types/wicg-file-system-access": "^2020.9.8",
    "axios": "^1.7.9",
    "baseline-browser-mapping": "^2.10.34",
    "gulp": "^5.0.1",
    "gulp-inline-source": "^4.0.0",
    "gulp-replace": "^1.1.4",
    "inline-source-cli": "^2.0.0",
    "jasmine-core": "~5.2.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.9.3"
  }
}